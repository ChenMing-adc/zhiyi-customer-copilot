# Copy to .env and fill in your provider settings. Never commit real credentials.
AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TEMPERATURE=0.35
AI_MAX_TOKENS=512

# Optional Ollama provider (set AI_PROVIDER=ollama to use it).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
